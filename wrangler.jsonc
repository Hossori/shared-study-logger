{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shared-study-logger",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application"
	},
	// D1: users / groups / group_members / study_records / push_subscriptions を格納
	// users.role は ADMIN / USER（DEFAULT USER）。ロール変更は SQL で行う。
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "shared-study-logger-db",
			"database_id": "de455ad0-4b51-491f-aaab-92e456e0ed37",
			"migrations_dir": "migrations"
		}
	],
	// Workers KV: セッションストア（session:{token} -> { userId, expiresAt }）
	"kv_namespaces": [
		{
			"binding": "SESSIONS",
			"id": "866cf1c34dda41199499692e4252bb6e"
		}
	],
	// Cloudflare Queues: 投稿成功時にメンバー1人につき1メッセージをenqueueし、
	// queue()ハンドラ（src/worker/index.ts）でWeb Push送信を行う。
	// 詳細は .cursor/skills/shared-study-logger-overview/reference/push.md を参照。
	"queues": {
		"producers": [
			{
				"binding": "PUSH_QUEUE",
				"queue": "push-notifications"
			}
		],
		"consumers": [
			{
				"queue": "push-notifications",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 3,
				"dead_letter_queue": "push-notifications-dlq"
			}
		]
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * シークレット（wrangler secret put で設定。ローカルは .dev.vars を利用）
	 * - VAPID_PRIVATE_KEY: Web Push署名用の秘密鍵（@pushforge/builderで使用）
	 */
}
