{
  "autoRun": {
    "allow_instructions": [
      "コミット前ゲート用の pnpm コマンド（test / lint / format:check / typecheck / check）を許可する",
      "読み取り専用 git コマンド（status / diff / log / show / rev-parse / ls-files / blame / remote -v）を許可する",
      "rg / git grep によるコード検索を許可する",
      "作業ブランチに対する `git add` / `git commit` / `git push` は許可する（`develop` への直接コミットや force push は除く）",
      "GitHub MCP の読み取りツール、shadcn の検索・閲覧、cloudflare-docs の参照を許可する"
    ],
    "block_instructions": [
      "プロジェクト外のファイルを変更する操作は許可しない",
      "git管理していないファイルを変更する操作は許可しない",
      "gitの履歴を書き換える操作は許可しない",
      "権限の変更は許可しない",
      "本番環境へのアクセスは許可しない",
      "`pnpm deploy` / `wrangler deploy`（dry-run 以外）を許可しない",
      "`git push --force` を許可しない",
      "GitHub MCP の書き込み操作を許可しない",
      "Playwright MCP / IDE Browser 操作を許可しない"
    ]
  },
  "terminalAllowlist": [
    "pnpm test",
    "pnpm lint",
    "pnpm run lint",
    "pnpm run format:check",
    "pnpm format:check",
    "pnpm run typecheck",
    "pnpm typecheck",
    "pnpm run typecheck:tests",
    "pnpm run check",
    "pnpm check",
    "git status",
    "git diff",
    "git log",
    "git show",
    "git rev-parse",
    "git ls-files",
    "git blame",
    "git remote -v",
    "git add",
    "git commit",
    "rg",
    "git grep"
  ],
  // 部分 glob（`github:list_*` 等）は一致しない
  "mcpAllowlist": [
    "github:search_users",
    "github:search_repositories",
    "github:search_pull_requests",
    "github:search_issues",
    "github:search_commits",
    "github:search_code",
    "github:pull_request_read",
    "github:list_tags",
    "github:list_repository_collaborators",
    "github:list_releases",
    "github:list_pull_requests",
    "github:list_issues",
    "github:list_issue_types",
    "github:list_issue_fields",
    "github:list_commits",
    "github:list_branches",
    "github:issue_read",
    "github:get_teams",
    "github:get_team_members",
    "github:get_tag",
    "github:get_release_by_tag",
    "github:get_me",
    "github:get_latest_release",
    "github:get_label",
    "github:get_file_contents",
    "github:get_commit",
    "user-github:search_users",
    "user-github:search_repositories",
    "user-github:search_pull_requests",
    "user-github:search_issues",
    "user-github:search_commits",
    "user-github:search_code",
    "user-github:pull_request_read",
    "user-github:list_tags",
    "user-github:list_repository_collaborators",
    "user-github:list_releases",
    "user-github:list_pull_requests",
    "user-github:list_issues",
    "user-github:list_issue_types",
    "user-github:list_issue_fields",
    "user-github:list_commits",
    "user-github:list_branches",
    "user-github:issue_read",
    "user-github:get_teams",
    "user-github:get_team_members",
    "user-github:get_tag",
    "user-github:get_release_by_tag",
    "user-github:get_me",
