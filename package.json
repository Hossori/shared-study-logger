{
	"name": "shared-study-logger",
	"description": "A template for building a React application with Vite, Hono, and Cloudflare Workers",
	"cloudflare": {
		"label": "Vite React Template",
		"products": [
			"Workers"
		],
		"categories": [],
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/532a5378-9717-4964-385b-5fafd2160200/public",
		"preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/ec7f4be5-d1d6-4e94-0851-126341745400/preview",
		"publish": true
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@pushforge/builder": "^2.0.5",
		"@tanstack/react-query": "^5.101.4",
		"axios": "^1.19.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"hono": "^4.11.1",
		"lucide-react": "^1.31.0",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"react-router": "^7.18.2",
		"shadcn": "^4.17.0",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.15.3",
		"@cloudflare/vitest-pool-workers": "^0.20.3",
		"@eslint/js": "9.39.1",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"simple-git-hooks": "^2.13.1",
		"tailwindcss": "^4.3.3",
		"typescript": "5.9.3",
		"typescript-eslint": "8.48.0",
		"vite": "^7.0.0",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.10",
		"workbox-precaching": "^7.4.1",
		"wrangler": "4.88.0"
	},
	"private": true,
	"scripts": {
		"build": "tsc -b && vite build",
		"cf-typegen": "wrangler types",
		"check": "tsc && vite build && wrangler deploy --dry-run",
		"check:zod-deprecated": "node scripts/check-zod-deprecated.mjs",
		"deploy": "wrangler deploy",
		"dev": "vite",
		"format": "prettier --write \"src/react-app/**/*.{ts,tsx}\" \"shared/**/*.ts\"",
		"format:check": "prettier --check \"src/react-app/**/*.{ts,tsx}\" \"shared/**/*.ts\"",
		"lint": "eslint .",
		"prepare": "simple-git-hooks",
		"preview": "pnpm build && vite preview",
		"seed": "node scripts/seed-users.mjs",
		"seed:reset": "node scripts/seed-users.mjs --reset",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:worker": "vitest run --config vitest.worker.config.ts",
		"test:e2e": "playwright test",
		"typecheck": "tsc -b",
		"typecheck:tests": "tsc -b tsconfig.unit.json tsconfig.tests.worker.json",
		"playwright:install": "playwright install chromium"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm exec lint-staged"
	},
	"lint-staged": {
		"src/react-app/**/*.{ts,tsx}": "prettier --write",
		"shared/**/*.ts": "prettier --write"
	},
	"type": "module",
	"packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
